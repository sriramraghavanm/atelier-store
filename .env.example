# Neon Postgres connection string (use the pooled connection string).
# Neon console -> Project -> Connect -> "Pooled connection"
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Better Auth signing secret. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Public origin of this app. Used by Better Auth on the server.
BETTER_AUTH_URL="http://localhost:3000"

# Same origin, exposed to the browser for the Better Auth client.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
